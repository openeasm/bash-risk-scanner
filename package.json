{
  "name": "bash-risk-scanner",
  "version": "0.1.0",
  "description": "Tree-sitter based static risk scanner for Bash, Python, and Node.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bash-risk-scan": "./dist/cli.cjs",
    "code-risk-scan": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --clean",
    "check": "npm run lint && npm test && npm run evaluate",
    "evaluate": "npm run build && node scripts/evaluate.mjs",
    "evaluate:import-public": "node scripts/import-public-corpus.mjs",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=html --outputFile.html=reports/test-report.html",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "bash",
    "python",
    "nodejs",
    "shell",
    "security",
    "static-analysis",
    "tree-sitter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openeasm/bash-risk-scanner.git"
  },
  "homepage": "https://github.com/openeasm/bash-risk-scanner#readme",
  "bugs": {
    "url": "https://github.com/openeasm/bash-risk-scanner/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^3.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
